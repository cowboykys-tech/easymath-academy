academy.example.com {
    encode zstd gzip

    request_body {
        max_size 60MB
    }

    reverse_proxy 127.0.0.1:49321

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        -Server
    }
}
