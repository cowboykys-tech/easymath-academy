# 비밀값은 이 파일에 직접 넣지 않습니다. Windows 설치본은 DPAPI 암호화 저장소를 사용합니다.
ACADEMY_HOST=127.0.0.1
ACADEMY_PORT=49321
ACADEMY_DB_PATH=C:\Users\OWNER\AppData\Local\EasyMathAcademy\data\academy.sqlite3
ACADEMY_PHOTO_PATH=C:\Users\OWNER\AppData\Local\EasyMathAcademy\data\photos
ACADEMY_BACKUP_PATH=C:\Users\OWNER\Documents\EasyMath Backups
ACADEMY_BACKUP_RETENTION=30
ACADEMY_REQUIRE_OWNER_LOGIN=1
ACADEMY_HTTPS=1
KAKAO_REDIRECT_URI=https://academy.example.com/auth/kakao/callback
# AI 문안: template(기본), codex(설치 장소의 Codex 로그인), openai(API), auto(순서대로 시도)
ACADEMY_FEEDBACK_AI_PROVIDER=template
# Codex를 선택할 때만 설치 장소의 실행 파일/모델을 필요에 따라 지정합니다.
ACADEMY_CODEX_CLI=
ACADEMY_CODEX_FEEDBACK_MODEL=
ACADEMY_CODEX_TIMEOUT=90
# 카카오 송수신기는 설치 장소가 정해진 뒤 URL 또는 호환 CLI 중 하나만 지정합니다.
ACADEMY_MESSAGING_CONNECTOR_URL=
ACADEMY_MESSAGING_CONNECTOR_CLI=
# ACADEMY_MESSAGING_CONNECTOR_TOKEN은 비밀 저장소/환경 변수로만 주입합니다.
# OPENAI_API_KEY도 비밀 저장소/환경 변수로만 주입하며 이 파일에는 적지 않습니다.
OPENAI_FEEDBACK_MODEL=gpt-6-luna
